# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public, safe for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET - only for server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: WhatsApp Business API
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Optional: Email (Resend/ SendGrid)
RESEND_API_KEY=your-resend-api-key